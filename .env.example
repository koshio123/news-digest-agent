# LLM（"provider:model" 形式）。fast=クエリ生成・採点 / standard=要約
# Anthropic API を使う場合は ANTHROPIC_API_KEY も設定する
LLM_FAST=anthropic:claude-haiku-5-5
LLM_STANDARD=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=
# ローカルLLM（Ollama）で動かす場合の例
# LLM_FAST=ollama:qwen3:8b
# LLM_STANDARD=ollama:qwen3:14b

# Web検索（https://tavily.com）。未設定ならWeb検索をスキップ
TAVILY_API_KEY=

# Slack（Bot推奨: 記事ごとに投稿し、👍/👎 リアクションをフィードバックとして読む）
# 必要なスコープ: chat:write, reactions:read。Botを投稿先チャンネルに招待しておく
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# Bot を使わない簡易投稿（フィードバックは読めない）
SLACK_WEBHOOK_URL=

# 保存先（既定値のままでよい）
# DATA_DIR=data
# OUTPUT_DIR=output/digests
# PROFILE_PATH=profile.yaml
